{
  "name": "dsh-gsd",
  "version": "1.20.1-1.dsh022",
  "private": true,
  "description": "GSD — spec-driven coding workflow (72 skills, engine, hooks guards) as a DeepSeek Harness plugin bundle. Install: dsh plugin --profile <name> add dsh-gsd",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "icon": "icon.svg",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/pfmiles/dsh-gsd.git" },
  "homepage": "https://github.com/pfmiles/dsh-gsd#readme",
  "bugs": { "url": "https://github.com/pfmiles/dsh-gsd/issues" },
  "keywords": ["deepseek", "harness", "dsh", "dsh-plugin", "gsd", "skills", "workflow"],
  "author": "pf_miles",
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-hooks-claude-code": "0.2.2-rc.1",
    "@deepseek-ai/dsh-hook-protocol": "0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": "0.2.2-rc.1"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "skills",
    "gsd-core",
    "hooks",
    "config",
    "scripts"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs && node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
